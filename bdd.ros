#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -- $0 "$@"
|#
(progn
  (ros:ensure-asdf))

(let ((root (uiop:pathname-directory-pathname *load-pathname*)))
  (push root asdf:*central-registry*))

(ql:quickload :bknr.tag/bdd :verbose nil)

(defun main (&rest argv)
  "Runs every Scenario in bknr.tag.feature and exits 0 on success, 1
on failure."
  (declare (ignorable argv))
  (uiop:quit (if (bknr.tag/bdd:run-bdd) 0 1)))
