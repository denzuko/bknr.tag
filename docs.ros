#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -- $0 "$@"
|#
(progn
  (ros:ensure-asdf))

(let ((root (uiop:pathname-directory-pathname *load-pathname*)))
  (push root asdf:*central-registry*))

(ql:quickload :bknr.tag/docs :verbose nil)

(defun main (&rest argv)
  "Renders bknr.tag's manual to standard output."
  (declare (ignorable argv))
  (bknr.tag/docs:generate))
